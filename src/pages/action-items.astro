---
import { loadScribeSchema } from '../lib/scribe';
import { actionItems } from '../lib/content';
import '../styles/punch.css';

const schema = loadScribeSchema();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const items = actionItems();
const open = items.filter((i) => !i.done);
const done = items.filter((i) => i.done);

function doneLabel(value: ActionItemDate) {
  if (!value) return null;
  const d = value instanceof Date ? value : new Date(value);
  // Render in UTC. A bare `2026-10-23` in YAML parses to UTC midnight, so
  // formatting in a western local zone would show the day before.
  return Number.isNaN(d.getTime())
    ? null
    : d.toLocaleDateString('en-US', {
        month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
      });
}
type ActionItemDate = string | Date | undefined;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="robots" content="noindex, nofollow" />
<title>Action Items — OTC Fleet Services</title>
{schema.umamiWebsiteId && schema.umamiScriptUrl && (
  <script defer src={schema.umamiScriptUrl} data-website-id={schema.umamiWebsiteId}></script>
)}
</head>
<body>

<header class="sheet">
  <div class="mast">
    <h1>Action&nbsp;Items</h1>
    <span class="mast-meta"><b>OTC Fleet Services</b></span>
  </div>
  <p class="hint">
    <a class="backlink" href={`${base}/`}>&larr; All items for review</a> &middot;
    What&rsquo;s still open, and what&rsquo;s already done
  </p>
</header>

<div class="intro">
  <p>
    This is the running list. Dave keeps it current &mdash; if something here is already
    handled, or it&rsquo;s pointing at the wrong person, say so and it gets fixed.
  </p>
</div>

<div class="todo-head">
  <h2>Still open</h2>
  <span class="count">{open.length} of {items.length}</span>
</div>

{open.length === 0 ? (
  <ul class="todos"><li class="todo"><div class="box"></div><div class="todo-main">
    <div class="todo-title">Nothing outstanding right now.</div>
  </div></li></ul>
) : (
  <ul class="todos">
    {open.map((i) => (
      <li class="todo">
        <div class="box" aria-hidden="true"></div>
        <div class="todo-main">
          <div class="todo-title">
            {i.title}
            {i.owner && <span class="tag">{i.owner}</span>}
          </div>
          {i.detail && <div class="todo-detail">{i.detail}</div>}
        </div>
      </li>
    ))}
  </ul>
)}

{done.length > 0 && (
  <>
    <div class="todo-head">
      <h2>Done</h2>
      <span class="count">{done.length}</span>
    </div>
    <ul class="todos">
      {done.map((i) => (
        <li class="todo is-done">
          <div class="box" aria-hidden="true"></div>
          <div class="todo-main">
            <div class="todo-title">
              {i.title}
              {i.owner && <span class="tag">{i.owner}</span>}
            </div>
            {i.detail && <div class="todo-detail">{i.detail}</div>}
            {doneLabel(i.doneOn) && <div class="todo-done-on">Done {doneLabel(i.doneOn)}</div>}
          </div>
        </li>
      ))}
    </ul>
  </>
)}

<footer class="colophon">
  Last updated when this page was published &mdash; if something looks stale, it probably is.
  Ask and we&rsquo;ll refresh it.
</footer>

</body>
</html>
