---
import { loadScribeSchema } from '../lib/scribe';
import '../styles/punch.css';

const schema = loadScribeSchema();
// BASE_URL is '/otc-review' on the project page and '/' behind a custom domain.
// Strip any trailing slash so a single join style works for both.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Add an entry here when there's another artifact for OTC to look at.
// `href: null` renders it as a greyed-out "coming up" card.
const artifacts = [
  {
    title: 'Action Items',
    kind: 'Read · running list',
    href: `${base}/action-items`,
    blurb:
      'Everything still open on your side, and what\u2019s already done. Dave keeps this ' +
      'current, so it\u2019s the quickest way to see what we\u2019re waiting on without ' +
      'digging back through email.',
    meta: 'updated as things move',
  },
  {
    title: 'FullBay Punch List',
    kind: 'Mark up · 217 items',
    href: `${base}/punch-list`,
    blurb:
      'Everything FullBay does, section by section. Mark each one V1 (needed day one), ' +
      'Later, or Not needed — and leave a note anywhere we got it wrong. This is what ' +
      'decides scope, so the 36 items tagged Key are the ones that matter most.',
    meta: '12 sections · about 30–45 minutes · your answers save as you go',
  },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="robots" content="noindex, nofollow" />
<title>For Review — OTC Fleet Services</title>
{schema.umamiWebsiteId && schema.umamiScriptUrl && (
  <script defer src={schema.umamiScriptUrl} data-website-id={schema.umamiWebsiteId}></script>
)}
</head>
<body>

<header class="sheet">
  <div class="mast">
    <h1>For&nbsp;Review</h1>
    <span class="mast-meta"><b>OTC Fleet Services</b></span>
  </div>
  <p class="hint">Everything we need your eyes on, in one place</p>
</header>

<div class="intro">
  <p>
    Each item below is something to read through and mark up. Your answers save in the
    browser as you go, so you can stop partway and pick it back up — on this device, in
    this browser. Nothing is final until you send it, and sending it again later is fine.
  </p>
</div>

<ul class="cards">
  {artifacts.map((a) => (
    <li class={a.href ? 'card' : 'card soon'}>
      <div class="card-top">
        <h2>{a.title}</h2>
        <span class="card-kind">{a.kind}</span>
      </div>
      <div class="card-in">
        <p>{a.blurb}</p>
        <div class="card-meta">{a.meta}</div>
        {a.href && <a class="card-go" href={a.href}>Open it</a>}
      </div>
    </li>
  ))}
</ul>

<footer class="colophon">
  Questions on any of this — or something here that doesn&rsquo;t match how you actually
  work — say so in a note on the item. That&rsquo;s the most useful thing you can give us.
</footer>

</body>
</html>
