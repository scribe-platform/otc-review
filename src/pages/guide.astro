---
import { loadScribeSchema } from '../lib/scribe';
import MEDIA from '../data/guide-media.json';
import '../styles/punch.css';
import '../styles/guide.css';

const schema = loadScribeSchema();
// BASE_URL is '/otc-review' on the project page and '/' behind a custom domain.
// Strip any trailing slash so a single join style works for both.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// The videos and stills live in public/guide/media/, copied there from
// fleetco/docs/Product/v1-index by its build.py + files.json. Re-render the
// videos and that copy has to be redone, along with src/data/guide-media.json.
const MEDIA_BASE = `${base}/guide/media`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="robots" content="noindex, nofollow" />
<title>Graphics V1 Guide — OTC Fleet Services</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Kalam:wght@400;700&display=swap" />
{schema.umamiWebsiteId && schema.umamiScriptUrl && (
  <script defer src={schema.umamiScriptUrl} data-website-id={schema.umamiWebsiteId}></script>
)}
</head>
<body class="guide-page">

<header class="sheet">
  <div class="mast">
    <h1>Graphics V1&nbsp;Guide</h1>
    <span class="mast-meta">
      <b>OTC Fleet Services</b>
      <i>33 videos &amp; pictures</i>
    </span>
  </div>
  <p class="hint">
    <a class="backlink" href={`${base}/`}>&larr; All items for review</a> &middot;
    Start with the overview, then open any card &middot; <b>Blue questions</b> need an answer from you
  </p>
</header>

<div class="guide">
<div class="wrap">
  <header>
    <div class="eyebrow">OTC Fleet Graphix &middot; Version 1</div>
    <h1>What&rsquo;s in version 1</h1>
    <p class="lede">Start with the 3-minute overview video. Below it, each part of the system is broken into short videos and pictures you can open one at a time.</p>
    <div class="stamp">These are sketches &middot; they show what each screen does, not the final design</div>
  </header>

  <section class="hero" aria-label="Overview video">
    <button class="player" data-open="overview" aria-label="Play the overview video">
      <img src={`${MEDIA_BASE}/thumbs/overview.jpg`} alt="Sketch of the job board" />
      <span class="play"><span><svg width="26" height="30" viewBox="0 0 26 30"><path d="M2 2 L24 15 L2 28 Z" fill="#fbfbf9"/></svg></span></span>
      <span class="dur">3:01</span>
    </button>
    <div class="hero-copy">
      <div class="eyebrow">Start here</div>
      <h3>One job, from estimate to paid invoice</h3>
      <ol class="chapters">
        <li class="t">0:16</li><li>Build an estimate from saved packages</li>
        <li class="t">0:46</li><li>Customer approves, deposit recorded</li>
        <li class="t">0:57</li><li>The job moves across the board</li>
        <li class="t">1:10</li><li>The technician does the job</li>
        <li class="t">1:31</li><li>Owner reviews, closes the job, sends the invoice</li>
        <li class="t">2:06</li><li>Timesheets and payroll</li>
        <li class="t">2:19</li><li>Built for the repair shops to join later</li>
        <li class="t">2:38</li><li>What isn&rsquo;t in V1</li>
      </ol>
    </div>
  </section>

  <section class="map" aria-label="Map of V1">
    <div class="map-head"><h2>How a job moves through the system</h2><span class="mock">Each section below covers one step</span></div>
    <div class="loop" id="loop"></div>
    <div class="back">then on to the next job</div>
    <div class="support-label">Also included</div>
    <div class="support" id="support"></div>
  </section>

  <div id="areas" style="display:flex;flex-direction:column;gap:44px"></div>

  <section class="notv1" id="not-v1" aria-label="Not in V1">
    <div><div class="eyebrow">Just as important to know</div><h2>Not in version 1</h2></div>
    <div class="nlist" id="nlist"></div>
  </section>

  <div class="foot">Questions in blue need an answer from you before that part is final.</div>
</div>

<div id="layer"></div>
</div>

<footer class="colophon">
  Something here that doesn&rsquo;t match how you actually work &mdash; or a question you can
  answer now &mdash; say so and it gets fixed before this is final.
</footer>

<script is:inline define:vars={{ MEDIA, MEDIA_BASE }}>
// MEDIA is src/data/guide-media.json, extracted from v1-index's build:
// { "1.1": { kind, file, seconds } }
const mmss = (sec) => `${Math.floor(sec / 60)}:${String(Math.round(sec) % 60).padStart(2, "0")}`;

// kind: "video" or "picture". len: rough video length, used until the real one is known.
// ask: an open question that has to be settled before the flow is final.
const AREAS = [
  { id: "estimates", n: 1, loop: true, title: "Estimates and approval", short: "Price the job, get the customer's OK",
    blurb: "Price the job, record the customer's approval, and record a deposit.",
    flows: [
      { t: "Build an estimate from a saved package", d: "Add a vehicle, pick a saved package, and every line fills in, with your cost, price and margin.", kind: "video", len: "1:00" },
      { t: "What you see vs. what the customer sees", d: "You see every line. The customer sees one line and one price per vehicle.", kind: "picture" },
      { t: "Send the estimate and record approval", d: "Email the estimate from the system, then record which vehicles the customer approved or turned down, who said yes, when, and how.", kind: "video", len: "0:45", ask: "Approve with one click from the email?" },
      { t: "Deposits", d: "Record a deposit and it comes off the final invoice. Taking it by card link is a choice still to make.", kind: "picture", ask: "Collect deposits by card link?" },
      { t: "Customers and their vehicles", d: "Each customer's vehicles and trailers, plus optional PO numbers.", kind: "picture", ask: "Track signs and walls like vehicles?" },
    ] },
  { id: "jobs", n: 2, loop: true, title: "Scheduling and tracking jobs", short: "See every job and where it stands",
    blurb: "Every open job in one place: who's on it, what stage it's in, and when it's due.",
    flows: [
      { t: "Approved estimate becomes a job", d: "Click Create job on the approved estimate. The approved lines carry over, so nothing is typed twice.", kind: "picture" },
      { t: "Job board", d: "Each job is a card that moves through six stages, like In production and Ready for installation.", kind: "video", len: "0:45" },
      { t: "Job list", d: "The same jobs as a searchable list. Filter by stage, customer, technician or date.", kind: "picture" },
      { t: "Schedule", d: "A calendar with production dates and install dates kept separate.", kind: "picture" },
      { t: "Job details", d: "Instructions, files, photos, who's assigned, and notes, all on one page.", kind: "picture", ask: "How should design proofs work?" },
    ] },
  { id: "phone", n: 3, loop: true, title: "Doing the job", short: "What the technician uses, at a computer or on a phone",
    blurb: "The technician uses the same system at a shop computer or on a phone at the vehicle. Either way, they see only their own jobs, and never costs, markup or profit.",
    flows: [
      { t: "My jobs at the shop computer", d: "The technician's own jobs on the board and schedule, with instructions and files.", kind: "picture" },
      { t: "Clock in and out", d: "Clocking in for the day is separate from time spent on jobs. Works from the computer or the phone.", kind: "picture" },
      { t: "Track time and finish with photos", d: "Start a timer at the computer, finish at the van with photos on the phone, and send the job for review. Only one timer runs at a time.", kind: "video", len: "1:12" },
      { t: "What a technician can't see", d: "Costs, markup and profit stay hidden.", kind: "picture" },
      { t: "Before-and-after checklist", d: "Note the vehicle's condition before installing, and do a final quality check.", kind: "picture", ask: "Which checklist items?" },
    ] },
  { id: "invoicing", n: 4, loop: true, title: "Invoicing and payments", short: "Bill the customer and get paid",
    blurb: "Review the finished work, close the job, send the invoice, and record payment.",
    flows: [
      { t: "Review and close the finished job", d: "Look at the photos, compare estimated and actual hours, and close the job. The draft invoice is created for you.", kind: "video", len: "0:40" },
      { t: "What the invoice looks like", d: "One line per vehicle, the deposit already taken off, and any other unpaid invoices listed.", kind: "picture", ask: "Sales tax rates from accounting, and the business name customers see" },
      { t: "Get paid by card", d: "Email the invoice from the system with the PDF and a pay-by-card link. The balance updates when they pay.", kind: "video", len: "0:35", ask: "Card processor and fees to confirm" },
      { t: "Recording checks and bank payments", d: "Enter payments that came in another way.", kind: "picture" },
      { t: "Connecting to QuickBooks", d: "Invoices and payments are sent to QuickBooks Online.", kind: "picture", ask: "Two-way sync, or send invoices only?" },
    ] },
  { id: "materials", n: 5, title: "Materials and ordering", short: "Prices, saved packages, vendor orders",
    blurb: "What materials cost, what you charge for them, and ordering from vendors.",
    flows: [
      { t: "Materials list", d: "Each material with what you pay and what you charge.", kind: "picture" },
      { t: "Saved packages", d: "Save a common job, like a full wrap, once. Add it to any estimate in one step.", kind: "picture" },
      { t: "Ordering from vendors", d: "Create a purchase order and email the PDF from your own account. When it all arrives, mark the order received and your costs update.", kind: "video", len: "0:45" },
    ] },
  { id: "payroll", n: 6, title: "Time and payroll", short: "Hours, payroll export, who sees what",
    blurb: "Check employee hours, export them for payroll, and control what each person can see.",
    flows: [
      { t: "Approve timesheets", d: "Fix missed clock-ins and approve the pay period.", kind: "video", len: "0:35" },
      { t: "Export hours for payroll", d: "Approved hours by employee and day, as a spreadsheet or printout. No pay rates or payroll connection.", kind: "picture" },
      { t: "Who can see what", d: "Two roles to start: owner and technician.", kind: "picture", ask: "Confirm what a technician can see" },
    ] },
  { id: "reports", n: 7, title: "Reports", short: "Nine reports to print or export",
    blurb: "The reports you picked from FullBay's list. Each one prints and exports to a spreadsheet.",
    flows: [
      { t: "Money reports", d: "Who owes you, revenue, jobs ready to bill, and payments received.", kind: "picture" },
      { t: "Work in progress", d: "Two views of work that's under way. What counts is still to be decided.", kind: "picture", ask: "What should count here?" },
      { t: "Time reports", d: "Hours clocked, hours per job, and timesheets.", kind: "picture" },
    ] },
  { id: "setup", n: 8, title: "Setup and moving off FullBay", short: "Settings, email, devices, the switch",
    blurb: "Built so other divisions can join later, email templates, the devices it runs on, and the move off FullBay.",
    flows: [
      { t: "Using your own words", d: "Graphics is the only division in version 1. Each division can use its own words, so a repair shop could say service order.", kind: "video", len: "0:30" },
      { t: "Computer, phone or tablet", d: "Everyone uses the same system in a web browser. On a phone it fits the small screen and saves to the home screen.", kind: "picture" },
      { t: "Moving off FullBay", d: "A plan for bringing over open jobs and unpaid invoices.", kind: "picture", ask: "Who enters them, and when? Plus invoice number and tax rates" },
      { t: "Email templates", d: "One editable template each for invoice and estimate emails: subject, message, signature and logo.", kind: "picture" },
    ] },
];

const NOT_V1 = [
  ["A customer website or login", "Invoices go out as a PDF with a pay link", "Confirm no customer portal"],
  ["Emailing purchase orders, reminders or overdue notices", "Invoices and estimates are emailed from the system. Orders are downloaded and sent as today"],
  ["Counting stock on the shelf", "The materials list keeps costs and prices. Stock is still checked by eye"],
  ["The repair shops", "Lancaster, mobile and postal stay on FullBay for now"],
  ["Switching between shops or departments", "One department, graphics, at launch"],
  ["Leads, sales follow-up, texting", "These stay in GoHighLevel. Approved jobs are typed in"],
  ["Fleet features like QR driver reports and insurance tracking", "These stay in myOTCFleet"],
  ["Maintenance schedules, inspections and DVIR", "Part of the repair shops, later"],
  ["Vendor portal and paying vendors", "Orders go out as a PDF from your own email"],
  ["Partial deliveries on orders", "An order is marked received as a whole"],
  ["Automatic markup", "You set each selling price yourself"],
  ["Pay rates, paychecks or a payroll connection", "Hours export as a spreadsheet or printout"],
  ["Building your own reports, or scheduled report emails", "The nine reports print and export"],
  ["More roles, like office or accounting", "Owner and technician to start"],
  ["An app from the App Store", "It runs in the phone's browser instead"],
  ["Working without internet", "Needs wifi or a cell signal"],
  ["Bank transfer (ACH) by link", "Card by link. Checks and bank transfers entered by hand"],
  ["Old records from FullBay", "Open work moves over. Old records stay in FullBay to look up"],
  ["Repair labor guides, VMRS codes and parts websites", "Repair-shop tools, for later"],
];

const $ = (s) => document.querySelector(s);
const allFlows = {};

$("#loop").innerHTML = AREAS.filter((a) => a.loop).map((a) => `<a href="#${a.id}"><span class="n">${a.n}</span><b>${a.title}</b><span class="d">${a.short}</span></a>`).join("");
$("#support").innerHTML = AREAS.filter((a) => !a.loop).map((a) => `<a href="#${a.id}"><span class="n">${a.n}</span><b>${a.title}</b><span class="d">${a.short}</span></a>`).join("");

$("#areas").innerHTML = AREAS.map((a) => {
  const flows = a.flows.map((f, i) => {
    const key = `${a.n}.${i + 1}`, m = MEDIA[key];
    return { ...f, key, area: a.title, m, kind: m ? m.kind : f.kind, len: m && m.seconds ? mmss(m.seconds) : f.len };
  });
  const v = flows.filter((f) => f.kind === "video").length, p = flows.length - v;
  const cards = flows.map((f) => {
    allFlows[f.key] = f;
    const thumb = f.m ? `<div class="thumb"><img src="${MEDIA_BASE}/thumbs/${f.key}.jpg" alt="" loading="lazy">` : `<div class="thumb x">`;
    const kind = f.kind === "video"
      ? `<span class="kind video"><svg width="8" height="9" viewBox="0 0 8 9"><path d="M0 0 L8 4.5 L0 9 Z" fill="#fbfbf9"/></svg>Video · ${f.len}</span>`
      : `<span class="kind">Picture</span>`;
    return `<button class="flow" data-flow="${f.key}">${thumb}${kind}</div><div class="flow-body"><span class="flow-id">${f.key}</span><b>${f.t}</b><span class="d">${f.d}</span>${f.ask ? `<span class="flag">? ${f.ask}</span>` : ""}</div></button>`;
  }).join("");
  return `<section class="area" id="${a.id}"><div class="area-head"><div class="area-num">${a.n}</div><div><h2>${a.title}</h2><p>${a.blurb}</p></div>
    <div class="counts">${v} video${v === 1 ? "" : "s"} · ${p} picture${p === 1 ? "" : "s"}</div></div><div class="flows">${cards}</div></section>`;
}).join("");

$("#nlist").innerHTML = NOT_V1.map(([a, b, ask]) => `<div><span><b>${a}</b><span>${b}</span>${ask ? `<span class="flag">? ${ask}</span>` : ""}</span></div>`).join("");

function openFlow(key) {
  const f = key === "overview"
    ? { t: "One job, from estimate to paid invoice", area: "Overview", d: "The full loop in one pass.", m: { kind: "video", file: "overview.mp4" } }
    : allFlows[key];
  const poster = key === "overview" ? "overview" : key;
  const media = !f.m ? `<div class="thumb x"></div><span class="mock">Coming soon.</span>`
    : f.m.kind === "video" ? `<video src="${MEDIA_BASE}/${f.m.file}" poster="${MEDIA_BASE}/thumbs/${poster}.jpg" controls autoplay playsinline></video>`
    : `<img src="${MEDIA_BASE}/${f.m.file}" alt="${f.t}">`;
  $("#layer").innerHTML = `<div class="scrim" data-close="1"><div class="viewer" role="dialog" aria-modal="true" aria-label="${f.t}">
    <div class="row"><div><div class="eyebrow">${f.area}${f.key ? " · " + f.key : ""}</div><h4>${f.t}</h4></div><button class="btn" data-close="1" id="close">Close</button></div>
    ${media}<div class="small">${f.d}${f.ask ? ` <span class="flag">? ${f.ask}</span>` : ""}</div></div></div>`;
  $("#close").focus();
}
document.addEventListener("click", (e) => {
  const c = e.target.closest("[data-close]");
  if (c && (c.classList.contains("btn") || e.target === c)) { $("#layer").innerHTML = ""; return; }
  const b = e.target.closest("[data-flow], [data-open]");
  if (b) openFlow(b.dataset.flow || b.dataset.open);
});
document.addEventListener("keydown", (e) => { if (e.key === "Escape") $("#layer").innerHTML = ""; });
</script>

</body>
</html>
